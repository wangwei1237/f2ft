<?xml version="1.0" encoding="utf-8"?>
<!-- API key and preferences stay on device: exclude everything from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
